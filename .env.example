NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NEXT_PUBLIC_APP_BASE_URL= # Optional explicit canonical URL; Netlify provides URL when omitted
# NEXT_PUBLIC_COOKIE_DOMAIN= # Optional production cookie domain

# RESEND_API_KEY=        # Resend API key — used by app/lib/email.ts AND as the Supabase Auth SMTP password (supabase/config.toml); leave empty to disable both
# EMAIL_FROM_ADDRESS=    # e.g. "OpenCiVera <noreply@opencivera.com>" — requires domain verification in Resend before setting this
